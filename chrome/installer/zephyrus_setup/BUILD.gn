# The Zephyrus installer's user interface.
#
# Deliberately free of //base and of everything else in this repository. An
# installer runs on a machine that has none of our code on it yet, and every
# dependency is one more thing that can be missing or mismatched at the exact
# moment a first impression is being made. What it needs -- a window, Direct2D
# and DirectWrite -- ships with Windows.

assert(is_win)

# The mascot is a table of rectangles and a few interpolators, with no
# dependencies at all -- which is also why the browser's agent panel can share
# it, and the two cannot drift apart.
source_set("mascot") {
  sources = [
    "mascot.cc",
    "mascot.h",
  ]
}

executable("zephyrus_setup") {
  sources = [
    "installer_runner.cc",
    "installer_runner.h",
    "setup_resource_ids.h",
    "setup_resources.rc",
    "setup_window.cc",
  ]
  deps = [ ":mascot" ]

  configs -= [ "//build/config/win:console" ]
  configs += [ "//build/config/win:windowed" ]

  libs = [
    "d2d1.lib",
    "dwrite.lib",
    "ole32.lib",
    "shell32.lib",
  ]
}
