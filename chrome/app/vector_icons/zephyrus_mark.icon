// The Zephyrus mark: the white ribbon inside the browser logo's tile (the
// path of chrome/app/theme/chromium/product_logo.svg), scaled from its
// 251x251 box onto a 24 canvas. Tinted like any other icon.

CANVAS_DIMENSIONS, 24,
FILL_RULE_NONZERO,
MOVE_TO, 0.0, 0.0,
CUBIC_TO, 0.0, 41.613, 19.44, 14.134, 24.0, 0.0,
CUBIC_TO, 24.0, -7.806, 24.0, 65.632, 24.0, 24.019,
CUBIC_TO, 24.0, -17.594, 4.56, 9.884, 0.0, 24.019,
CUBIC_TO, 0.0, 31.825, 0.0, -41.613, 0.0, 0.0,
CLOSE,
