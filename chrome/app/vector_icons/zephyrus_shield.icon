// The Shield.
//
// Replaces a 141-command staircase built from 1.52-unit blocks on a 32 canvas
// -- the same pixel-block construction the nav arrows and reload used, and the
// same result: block edges landing mid-pixel and reading as low-resolution.
//
// Drawn as a filled silhouette rather than an outline. At the 18px this is
// used at in the toolbar, a stroked shield collapses into a grey smudge,
// whereas a solid one keeps its shape.
//
// Two canvas reps so the toolbar draws the 16 directly instead of scaling the
// 24 down.

CANVAS_DIMENSIONS, 24,
MOVE_TO, 12, 2.5f,
LINE_TO, 19.5f, 5.6f,
V_LINE_TO, 11.8f,
CUBIC_TO, 19.5f, 16.6f, 16.4f, 20.4f, 12, 21.5f,
CUBIC_TO, 7.6f, 20.4f, 4.5f, 16.6f, 4.5f, 11.8f,
V_LINE_TO, 5.6f,
CLOSE

CANVAS_DIMENSIONS, 16,
MOVE_TO, 8, 1.7f,
LINE_TO, 13, 3.7f,
V_LINE_TO, 7.9f,
CUBIC_TO, 13, 11.1f, 10.9f, 13.6f, 8, 14.3f,
CUBIC_TO, 5.1f, 13.6f, 3, 11.1f, 3, 7.9f,
V_LINE_TO, 3.7f,
CLOSE
