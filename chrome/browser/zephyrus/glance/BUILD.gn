import("//testing/test.gni")

# Glance's rules, with no views or content in them: which click opens a card,
# which addresses may, where the card sits and how it moves. The view that
# draws it is chrome/browser/ui/views/frame/zephyrus_glance.*.
source_set("glance") {
  sources = [
    "glance_policy.cc",
    "glance_policy.h",
  ]
  deps = [
    "//base",
    "//ui/gfx/geometry",
    "//url",
  ]
}

#   autoninja -C out/Release zephyrus_glance_unittests
test("zephyrus_glance_unittests") {
  sources = [ "glance_policy_unittest.cc" ]
  deps = [
    ":glance",
    "//base",
    "//base/test:run_all_unittests",
    "//testing/gtest",
    "//ui/gfx:test_support",
    "//ui/gfx/geometry",
    "//url",
  ]
}
