import("//testing/libfuzzer/fuzzer_test.gni")
import("//testing/test.gni")

# Bundles EasyList + EasyPrivacy next to the binary; the service reads it at
# startup from DIR_ASSETS.
copy("filter_list") {
  # The notice ships WITH the list, not separately: zephyrus_filters.txt is a
  # verbatim EasyList snapshot, so distributing it carries an attribution
  # obligation (CC BY-SA 3.0 / GPLv3). Keeping them in one target means the
  # list cannot be shipped without its credit.
  sources = [
    "lists/FILTER_LISTS_NOTICE.txt",
    "lists/zephyrus_filters.txt",
  ]
  outputs = [ "$root_out_dir/{{source_file_part}}" ]
}

# The rule engines alone: parsing and matching, with no browser in sight. Kept
# apart so their tests link in seconds instead of inside unit_tests, whose
# official-build link is long enough that nobody runs them.
source_set("engines") {
  sources = [
    "adblock_cosmetic_engine.cc",
    "adblock_cosmetic_engine.h",
    "adblock_filter_engine.cc",
    "adblock_filter_engine.h",
    "adblock_list_util.cc",
    "adblock_list_util.h",
    "adblock_param_filter.cc",
    "adblock_param_filter.h",
    "adblock_redirect_resources.cc",
    "adblock_redirect_resources.h",
    "adblock_regex_matcher.cc",
    "adblock_regex_matcher.h",
    "adblock_scriptlet_engine.cc",
    "adblock_scriptlet_engine.h",
    "adblock_shared_index.cc",
    "adblock_shared_index.h",
    "adblock_startup_gate.cc",
    "adblock_startup_gate.h",
    "adblock_urlskip_filter.cc",
    "adblock_urlskip_filter.h",
    "adblock_zindex.cc",
    "adblock_zindex.h",
  ]
  deps = [
    "//net",
    "//third_party/icu",
    "//third_party/re2",
  ]
  public_deps = [
    "//base",
    "//url",
  ]
}

# What each fuzz target feeds a parser and which invariant it asserts. Shared by
# the libFuzzer binaries below and by the deterministic mutation test, so the two
# can never drift apart.
source_set("fuzz_targets") {
  testonly = true
  sources = [
    "fuzz/adblock_fuzz_targets.cc",
    "fuzz/adblock_fuzz_targets.h",
  ]
  deps = [
    ":engines",
    "//base",
    "//third_party/re2",
    "//url",
  ]
}

#   autoninja -C out/Release chrome/browser/zephyrus/adblock:zephyrus_adblock_engine_unittests
test("zephyrus_adblock_engine_unittests") {
  sources = [
    "adblock_filter_engine_unittest.cc",
    "adblock_fuzz_regression_unittest.cc",
    "adblock_list_features_unittest.cc",
    "adblock_matcher_perftest.cc",
    "adblock_param_filter_unittest.cc",
    "adblock_redirect_resources_unittest.cc",
    "adblock_regex_matcher_unittest.cc",
    "adblock_shared_index_unittest.cc",
    "adblock_startup_gate_unittest.cc",
    "adblock_urlskip_filter_unittest.cc",
    "adblock_zindex_unittest.cc",
  ]
  deps = [
    ":engines",
    ":fuzz_targets",
    "//base",
    "//base/test:run_all_unittests",
    "//base/test:test_support",
    "//testing/gtest",
    "//third_party/icu",
    "//third_party/re2",
    "//url",
  ]
  data = [ "fuzz/corpus/" ]
}

# One libFuzzer binary per parser. Build in out/FUZZ (libFuzzer + ASAN):
#   autoninja -C out/FUZZ chrome/browser/zephyrus/adblock:zephyrus_adblock_list_parser_fuzzer
template("zephyrus_adblock_fuzzer") {
  fuzzer_test(target_name) {
    sources = [
      "fuzz/fuzzer_entry.h",
      invoker.source,
    ]
    deps = [
      ":engines",
      ":fuzz_targets",
      "//base",
      "//base:i18n",
      "//base/test:test_support",
    ]
    dict = "fuzz/adblock.dict"
    seed_corpus = invoker.seed_corpus
  }
}

zephyrus_adblock_fuzzer("zephyrus_adblock_list_parser_fuzzer") {
  source = "fuzz/list_parser_fuzzer.cc"
  seed_corpus = "fuzz/corpus/list"
}

zephyrus_adblock_fuzzer("zephyrus_adblock_index_blob_fuzzer") {
  source = "fuzz/index_blob_fuzzer.cc"
  seed_corpus = "fuzz/corpus/index_blob"
