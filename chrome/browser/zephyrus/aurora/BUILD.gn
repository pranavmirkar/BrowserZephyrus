import("//testing/test.gni")

# Where the aurora's colours come from: the vivid colours of a small picture of
# the page, tuned to glow on the chrome. Pure functions over an SkBitmap, with no
# views or content in them. The view that draws the aurora and captures the page is
# chrome/browser/ui/views/frame/zephyrus_aurora_view.*.
source_set("aurora") {
  sources = [
    "zephyrus_aurora_palette.cc",
    "zephyrus_aurora_palette.h",
  ]
  deps = [
    "//base",
    "//skia",
    "//ui/gfx",
  ]
}

#   autoninja -C out/Release zephyrus_aurora_unittests
test("zephyrus_aurora_unittests") {
  sources = [ "zephyrus_aurora_palette_unittest.cc" ]
  deps = [
    ":aurora",
    "//base",
    "//base/test:run_all_unittests",
    "//skia",
    "//testing/gtest",
    "//ui/gfx",
  ]
}
