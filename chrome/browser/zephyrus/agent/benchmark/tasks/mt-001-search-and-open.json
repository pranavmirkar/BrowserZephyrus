  "budget": 10,
  "optimal": 4,
  "start": "home",
  "states": {
    "home": {
      "observation": {
        "url": "https://example-docs.org/",
        "title": "Docs",
        "tabs": [
          {
            "id": 1,
            "title": "Docs",
            "active": true
