            "id": 1,
            "title": "Docs",
            "active": true
          }
        ],
        "elements": [
          {
            "id": "e32",
            "role": "button",
            "name": "Subscribe"
          }
        ],
        "text": "Email address filled in."
      }
    }
  },
  "success": {
    "states": [
      "guide"
    ],
    "call": "task.complete"
  },
  "paths": {
    "optimal": [
      {
        "name": "page.type",
        "arguments": {
          "element_id": "e12",
          "text": "thermal throttling"
