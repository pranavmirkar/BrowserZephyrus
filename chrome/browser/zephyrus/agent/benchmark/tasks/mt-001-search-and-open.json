        "text": "2 results for thermal throttling."
      },
      "on": [
        {
          "tool": "page.click",
          "element_id": "r1",
          "goto": "guide",
          "note": "opened Thermal throttling: a guide"
        },
        {
          "tool": "page.click",
          "element_id": "r2",
          "goto": "notes",
          "note": "opened Release notes 4.2"
