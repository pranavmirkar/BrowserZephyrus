    "typed": {
      "observation": {
        "url": "https://example-docs.org/",
        "title": "Docs",
        "tabs": [
          {
            "id": 1,
            "title": "Docs",
            "active": true
          }
        ],
        "elements": [
          {
            "id": "e12",
            "role": "textbox",
            "name": "Search docs",
            "value": "thermal throttling"
          },
          {
            "id": "e13",
            "role": "button",
            "name": "Search"
          }
        ],
        "text": "Documentation home. Search box contains: thermal throttling"
      },
      "on": [
        {
          "tool": "page.click",
          "element_id": "e13",
          "goto": "results",
          "note": "search ran"
        },
        {
          "tool": "page.press",
          "key": "Enter",
          "goto": "results",
          "note": "search ran"
        }
      ]
