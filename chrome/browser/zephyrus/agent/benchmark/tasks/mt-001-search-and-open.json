            "id": "e12",
            "role": "textbox",
            "name": "Search docs"
          },
          {
            "id": "e13",
            "role": "button",
            "name": "Search"
          },
          {
            "id": "e31",
            "role": "textbox",
            "name": "Email address"
          },
          {
            "id": "e32",
            "role": "button",
            "name": "Subscribe"
          }
        ],
        "text": "Documentation home. Browse guides and API reference."
      },
      "on": [
        {
          "tool": "page.type",
          "element_id": "e12",
          "text_contains": "throttl",
